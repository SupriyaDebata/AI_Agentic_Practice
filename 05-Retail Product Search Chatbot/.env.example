# Retail Product Search Chatbot — Environment Configuration
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
# ── Paths ──────────────────────────────────────────────────────────────
# These default to data/catalog.db, data/products.xlsx, etc.
# Change only if you have a non-standard setup.
# (Optional — can be left blank to use defaults)
# DB_PATH=data/catalog.db
# PRODUCTS_XLSX=data/products.xlsx
# VECTOR_STORE_DIR=data/vector_store
# BM25_INDEX_PATH=data/bm25_index.pkl

# ── LLM Configuration (Ollama) ────────────────────────────────────────────────
# Using Ollama for local LLM inference (no API key needed)
# Make sure Ollama is running: ollama serve
# Download model: ollama pull mistral (or neural-chat, llama2, etc.)

# Ollama server host and port
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Ollama model name to use
# Popular options:
# - mistral (7B, fastest, good reasoning)
# - neural-chat (7B, optimized for chat)
# - llama2 (7B, general purpose)
# - dolphin-mixtral (8x7B, powerful but slower)
OLLAMA_MODEL=mistral

# Temperature: 0.0 = deterministic (good for intent extraction)
# Higher = more creative (not needed for this task)
LLM_TEMPERATURE=0.0

# Max tokens for a single LLM call
LLM_MAX_TOKENS=1024

# Request timeout for LLM calls (in seconds)
# Increase this if you have slow network or large models
LLM_TIMEOUT=30

# ── Embeddings ─────────────────────────────────────────────────────────
# Model name for sentence-transformers
# all-MiniLM-L6-v2: 384-dim, fast, good for product descriptions
# (This is installed locally; no API needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Retrieval Configuration ────────────────────────────────────────────
# Top-K results to return to the user after reranking
DEFAULT_TOP_K=10

# Candidates to retrieve before fusion (each retriever)
BM25_CANDIDATE_K=20
VECTOR_CANDIDATE_K=20
SQL_CANDIDATE_K=50

# Reciprocal Rank Fusion constant (60 is standard)
RRF_K=60

# Final results returned after reranking
FINAL_TOP_K=5

# ── MCP Server Configuration ───────────────────────────────────────────
# Host and port for the MCP server (Phase 13)
MCP_HOST=127.0.0.1
MCP_PORT=8765

# ── API Server Configuration ───────────────────────────────────────────
# FastAPI server for the chatbot (Phase 21)
API_HOST=0.0.0.0
API_PORT=8000

# Set to true only for local development (exposes debug info)
API_DEBUG=false

# ── Logging ────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Week 7: LangSmith Observability ────────────────────────────────────
# Set LANGSMITH_TRACING=true to enable LangSmith request tracing.
# Get your API key from https://smith.langchain.com/settings
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=retail-chatbot-week7
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Week 7: Guardrail Toggles ───────────────────────────────────────────
# All guardrails are enabled by default.
# Set to false to disable a specific guardrail (useful for A/B testing).
GUARDRAIL_PII_ENABLED=true
GUARDRAIL_INJECTION_ENABLED=true
GUARDRAIL_TOPIC_ENABLED=true
GUARDRAIL_SAFETY_ENABLED=true
GUARDRAIL_PRICE_MANIPULATION_ENABLED=true
GUARDRAIL_PRODUCT_GROUNDING_ENABLED=true
GUARDRAIL_OUTPUT_SCHEMA_ENABLED=true
GUARDRAIL_TONE_ENABLED=true
GUARDRAIL_OUTPUT_SAFETY_ENABLED=true

# ── Week 7: External Content Safety Provider ────────────────────────────
# Supported values: "mock" (default, no external API), "azure"
# mock: uses built-in deterministic guardrails — no external API needed
# azure: uses Azure AI Content Safety (requires endpoint + key below)
CONTENT_SAFETY_PROVIDER=mock

# Azure AI Content Safety (only needed if CONTENT_SAFETY_PROVIDER=azure)
# Get these from your Azure portal → AI Content Safety resource
AZURE_CONTENT_SAFETY_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=your-azure-content-safety-key-here
