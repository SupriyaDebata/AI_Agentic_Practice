# Ollama configuration — no API key needed, runs fully locally
# Copy this file to .env and adjust values as needed

# Ollama model to use (must support tool calling)
# Options: llama3.1, llama3.2, mistral, qwen2.5
OLLAMA_MODEL=llama3.1

# Ollama server URL — change only if running Ollama on a different host or port
OLLAMA_HOST=http://localhost:11434

# Max agent iterations per user turn (safety limit, default 10)
MAX_ITERATIONS=10
